V = 8
C_I = 3
C_I_love = 2
C_I_study = 1
C_You = 1
C_You_study = 0

# (a) Before and after Laplace smoothing
P_love_before = C_I_love / C_I
P_love_after = (C_I_love + 1) / (C_I + V)

# (b) Total probability assigned to unseen words
seen_words = 2
unseen_words = V - seen_words
P_each_unseen = 1 / (C_I + V)
total_unseen_mass = unseen_words * P_each_unseen

k = 0.1
P_love_k = (C_I_love + k) / (C_I + k * V)
P_study_You_k = (C_You_study + k) / (C_You + k * V)

# Output
print("Q22. How Much Mass Does Laplace Steal?")

print("\n(a)")
print(f"Before: {C_I_love}/{C_I} ≈ {P_love_before:.3f}")
print(f"After: ({C_I_love}+1)/({C_I}+{V}) "
      f"= {C_I_love + 1}/{C_I + V} ≈ {P_love_after:.3f}")

print("\n(b)")
print("Seen words after I are love and study.")
print(f"Unseen words: {V} - {seen_words} = {unseen_words}")
print(f"Each with 1/11, so {unseen_words}/11 "
      f"≈ {total_unseen_mass:.3f} of the mass goes to unseen events.")

print("\n(c)")
print("P(love | I) = (2 + 0.1) / (3 + 0.1×8)")
print(f"            = {P_love_k:.3f}")
print("P(study | You) = (0 + 0.1) / (1 + 0.1×8)")
print(f"               = {P_study_You_k:.3f}")

print("\nComment:")
print("A smaller k keeps seen events closer to their MLE values;")
print("k is tuned on held-out data.")
