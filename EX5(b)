import re
from collections import defaultdict, Counter

corpus = """the quick brown fox jumps over the lazy dog
the dog barks at the fox
the quick fox runs away from the dog"""

def tokenize(sentence):
    sentence = sentence.lower()
    return ["<s>"] + re.findall(r"[a-z]+", sentence) + ["</s>"]

sentences = [tokenize(s) for s in corpus.strip().split("\n")]

# Count unigrams and bigrams
unigram_counts = Counter()
bigram_counts = Counter()

for tokens in sentences:
    unigram_counts.update(tokens)
    bigram_counts.update(zip(tokens, tokens[1:]))

# Build probability matrix
prob_matrix = defaultdict(dict)

for (w1, w2), count in bigram_counts.items():
    prob_matrix[w1][w2] = count / unigram_counts[w1]

# Print probability matrix
words = sorted(unigram_counts.keys())

print(f"{'Word':<12}", end="")
for word in words:
    print(f"{word:<10}", end="")
print()

print("-" * (12 + 10 * len(words)))

for w1 in words:
    print(f"{w1:<12}", end="")
    for w2 in words:
        print(f"{prob_matrix[w1].get(w2, 0):<10.3f}", end="")
    print()
