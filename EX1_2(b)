from collections import Counter 
# Given sentences 
sentences = [ 
"I like NLP", 
"I like Python", 
"I study NLP" 
] 
# ---------------- Unigram ---------------- 
words = [] 
for sentence in sentences: 
words.extend(sentence.split()) 
word_count = Counter(words) 
total_words = len(words) 
print("Unigram Probability")
for word in word_count: 
probability = word_count[word] / total_words 
print(f"{word} : {probability:.3f}") 
# ---------------- Bigram ---------------- 
bigrams = [] 
for sentence in sentences: 
tokens = sentence.split() 
for i in range(len(tokens) - 1): 
bigrams.append((tokens[i], tokens[i + 1])) 
bigram_count = Counter(bigrams) 
print("\nBigram Probability") 
for bigram in bigram_count: 
first_word = bigram[0] 
probability = bigram_count[bigram] / word_count[first_word] 
print(f"{bigram} : {probability:.3f}") 
