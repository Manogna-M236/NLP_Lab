# (a) Unigram counts
print("(a)")

print("C(<s>) = 4")
print("C(I) = 3")
print("C(love) = 3")
print("C(NLP) = 3")


# (b) Bigram counts
print("\n(b)")

print("I love = 2")
print("I study = 1")
print("love NLP = 2")
print("love deep = 1")


# (c) Bigram probabilities
print("\n(c)")

print("P(I | <s>) = 3/4")
print("P(love | I) = 2/3")
print("P(NLP | love) = 2/3")
print("P(</s> | NLP) = 3/3 = 1")


# (d) Sentence probability
print("\n(d)")

print("P(I love NLP) = 3/4 × 2/3 × 2/3 × 1")
print("              = 12/36")
print("              = 1/3")
print("              ≈ 0.333")
