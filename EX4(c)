import spacy
import nltk
from nltk.stem import WordNetLemmatizer

# Download WordNet data (only first time)
nltk.download('wordnet')
nltk.download('omw-1.4')

# Load spaCy model
nlp = spacy.load("en_core_web_sm")

# Initialize WordNet Lemmatizer
wnl = WordNetLemmatizer()

# Input paragraph
text = """
The children were playing happily in the gardens.
The mice ate the cheese and ran away.
The cats were chasing the birds.
"""

# spaCy Lemmatization
doc = nlp(text)

print(f"{'Word':<15}{'spaCy':<15}{'WordNet':<15}")
print("-" * 45)

for token in doc:
    if token.is_alpha:
        spacy_lemma = token.lemma_
        wordnet_lemma = wnl.lemmatize(token.text.lower())
        print(f"{token.text:<15}{spacy_lemma:<15}{wordnet_lemma:<15}")
