# (a) Morpheme segmentation and gloss
print("(a) Morpheme segmentation:")

print("evlerimizden = ev + ler + imiz + den")
print("ev   -> house")
print("ler  -> plural")
print("imiz -> our")
print("den  -> from")

print("Meaning: from our houses")


