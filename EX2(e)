import re 
# Sample Inputs 
aadhaar = "123456789012" 
pan = "ABCDE1234F" 
vehicle = "AP39AB1234" 
date = "29/07/2026" 
time = "10:45 PM" 
# Regex Patterns 
aadhaar_pattern = r"^\d{12}$" 
pan_pattern = r"^[A-Z]{5}[0-9]{4}[A-Z]$" 
vehicle_pattern = r"^[A-Z]{2}\d{2}[A-Z]{1,2}\d{4}$" 
date_pattern = r"^(0[1-9]|[12][0-9]|3[01])/(0[1-9]|1[0-2])/\d{4}$" 
time_pattern = r"^(0?[1-9]|1[0-2]):[0-5][0-9]\s?(AM|PM)$" 
print("Aadhaar:", "Valid" if re.fullmatch(aadhaar_pattern, aadhaar) else "Invalid") 
print("PAN:", "Valid" if re.fullmatch(pan_pattern, pan) else "Invalid") 
print("Vehicle Number:", "Valid" if re.fullmatch(vehicle_pattern, vehicle) else "Invalid") 
print("Date:", "Valid" if re.fullmatch(date_pattern, date) else "Invalid") 
print("Time:", "Valid" if re.fullmatch(time_pattern, time) else "Invalid")
