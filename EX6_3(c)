import nltk
from nltk.corpus import brown
from nltk.tag import UnigramTagger, BigramTagger

nltk.download('brown')

# Load tagged sentences from the Brown corpus
tagged_sentences = brown.tagged_sents(categories='news')

# Split into training and testing data (90% / 10%)
size = int(len(tagged_sentences) * 0.9)

train_data = tagged_sentences[:size]
test_data = tagged_sentences[size:]

# Train Unigram tagger
unigram_tagger = UnigramTagger(train_data)

# Train Bigram tagger with Unigram backoff
bigram_tagger = BigramTagger(
    train_data,
    backoff=unigram_tagger
)

# Evaluate accuracy
print("Unigram accuracy:", unigram_tagger.accuracy(test_data))
print("Bigram accuracy:", bigram_tagger.accuracy(test_data))
